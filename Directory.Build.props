<Project>
  <!-- Metadata & Package Identity -->
  <PropertyGroup>
    <Authors>Chad Bauers</Authors>
    <Company>Chad Bauers</Company>
    <Copyright>Copyright © 2026-$([System.DateTime]::Now.Year) Chad Bauers</Copyright>
    <Product>Centra Framework</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/chadahoochie/Centra</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chadahoochie/Centra</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>centra;distributed;cloudevents;actors;workflows;dotnet;microservices</PackageTags>
    <PackageReleaseNotes>See https://github.com/chadahoochie/Centra/blob/main/RELEASE_NOTES.md</PackageReleaseNotes>
  </PropertyGroup>

  <!-- Build & C# Language Settings -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Versioning Defaults -->
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
  </PropertyGroup>

  <!-- Non-Packable Projects (Tests & Samples) -->
  <PropertyGroup Condition="$(MSBuildProjectFullPath.Contains('/samples/')) or $(MSBuildProjectFullPath.Contains('\samples\')) or $(MSBuildProjectFullPath.Contains('/tests/')) or $(MSBuildProjectFullPath.Contains('\tests\'))">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Packaging & Symbol Defaults for Distributable Libraries -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1574;CS1573;CS1572;CS1570</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
</Project>
