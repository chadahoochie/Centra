<Project>
  <!-- Metadata -->
  <PropertyGroup>
    <Authors>Chad Bauers</Authors>
    <Company>Chad Bauers</Company>
    <Copyright>Copyright © 2026 Chad Bauers</Copyright>
    <Product>Centra Framework</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Build & C# Language Settings -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Versioning Defaults -->
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
  </PropertyGroup>
</Project>
