<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Hosting and dependency injection extensions for Centra Azure Cosmos DB provider.</Description>
    <RootNamespace>Centra.Providers.CosmosDb.Hosting</RootNamespace>
    <PackageTags>$(PackageTags);providers;cosmosdb;azure;hosting;dependency-injection</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Centra.Providers.CosmosDb\Centra.Providers.CosmosDb.csproj" />
    <ProjectReference Include="..\Centra.Runtime\Centra.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
