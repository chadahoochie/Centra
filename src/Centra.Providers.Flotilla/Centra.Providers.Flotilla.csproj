    <PackageTags>$(PackageTags);providers;flotilla;raft;consensus;pubsub;messaging;cloudevents</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Centra.Runtime\Centra.Runtime.csproj" />
