{
  "uuid": "centra-kitchen-sink-overview",
  "title": "Centra Distributed Framework - Kitchen Sink Overview",
  "description": "Comprehensive telemetry dashboard for Centra .NET 10 distributed application framework: Service Invocation RPC, RabbitMQ CNCF CloudEvents Pub/Sub, Redis/PostgreSQL/SQL Server State CAS, Distributed Locks, Cron Bindings, Actors, Sagas, and Polly Resilience.",
  "tags": [
    "centra",
    "dotnet10",
    "kitchen-sink",
    "distributed-framework",
    "signoz"
  ],
  "version": "v4",
  "uploadedGrafana": false,
  "variables": {},
