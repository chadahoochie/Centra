<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <Description>Traffic-generating worker that steadily exercises every capability of the Centra DockerStack sample (actors, pub/sub, state CAS, distributed locks, workflows, service invocation) so the Grafana dashboards always have live data.</Description>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
  </ItemGroup>
</Project>
