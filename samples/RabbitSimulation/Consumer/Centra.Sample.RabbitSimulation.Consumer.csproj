    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Centra.Hosting\Centra.Hosting.csproj" />
    <ProjectReference Include="..\..\..\src\Centra.Providers.RabbitMQ\Centra.Providers.RabbitMQ.csproj" />
    <ProjectReference Include="..\Contracts\Centra.Sample.RabbitSimulation.Contracts.csproj" />
  </ItemGroup>

</Project>
