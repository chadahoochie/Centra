<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>RabbitMQ event consumer service that processes incoming orders and uses Centra Service Invocation to call the API service.</Description>
    <RootNamespace>Centra.Sample.RabbitSimulation.Consumer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
